[Unit]
Description=Django application (gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory={{ app_dir }}
EnvironmentFile={{ app_dir }}/.env
ExecStart={{ app_dir }}/venv/bin/gunicorn project.wsgi:application --bind 127.0.0.1:{{ app_port }} --workers 2 --timeout 60
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
